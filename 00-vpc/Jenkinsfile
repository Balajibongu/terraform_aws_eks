pipeline{
    // agent any 
    agent{
        label "AGENT-1"
    }
    environment{
        name = "balaji"
    }
    options{
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds() 
        ansiColor('xterm')
    } 
    stages{
        stage("terraform init"){
            steps{
                script{
                    withAWS(credentials: 'aws-credentials', region: 'us-east-1'){
                        sh"""
                            cd 00-vpc
                            terraform init
                        """
                    }
                }
            }
        }
        stage("terraform plan"){
            steps{
                script{
                    withAWS(credentials: 'aws-credentials', region: 'us-east-1'){
                        sh """
                            cd 00-vpc
                            terraform plan
                        """
                    }
                }
            }
        }
        stage("terraform apply"){
            steps{
                script{
                    withAWS(credentials: 'aws-credentials', region: 'us-east-1'){
                        sh """
                            cd 00-vpc
                            terraform apply -auto-approve
                        """
                    }
                }
            }
        }
        stage("trigger security group"){
            steps{
                script{
                    build job: "10-security-group",
                    wait: false,
                    propagate: false
                }
            }
        }
    }

    post{
        always{
            echo "cleaning work space"
            cleanWs()
        }   
    }
}